# Well Model Builder - Environment Configuration Template
# Копируйте этот файл в .env и при необходимости меняйте настройки.

# Адреса микросервисов расчета
IPR_SERVICE_URL=http://ipr:8003
VLP_SERVICE_URL=http://vlp:8002
NODAL_SERVICE_URL=http://nodal:8004

# Порты локального запуска (если без Docker)
IPR_PORT=8003
VLP_PORT=8002
NODAL_PORT=8004
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ИИ-ассистент (Можно также задать прямо в веб-интерфейсе -> «Настройки» с сохранением в cookie на 30 дней)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=openai/gpt-4o-mini
LLM_API_KEY=
LLM_TIMEOUT_SEC=30
AI_MAX_STEPS=6
UPLOAD_STORAGE_DIR=/app/uploads
